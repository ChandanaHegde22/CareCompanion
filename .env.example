# ══════════════════════════════════════════════════════════════════════════════
#  CareCompanion – Environment Configuration
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── App Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=database/carecompanion.db

# ── File Paths ────────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=vector_store
UPLOADS_PATH=uploads
LOGS_PATH=logs

# ── Twilio SMS Alerts (Optional) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Email Alerts (Optional – SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@carecompanion.ai

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=CareCompanion
APP_VERSION=1.0.0
DEBUG=False
MAX_UPLOAD_MB=20
